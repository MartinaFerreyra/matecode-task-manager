# ── Frontend (públicas: Vite las incluye en el bundle, NO poner secretos aquí) ──
# Config web de Firebase (Consola de Firebase → Configuración del proyecto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend: solo Vercel Functions (api/). Sin prefijo VITE_, nunca llegan al navegador ──
# Mismo ID de proyecto de Firebase; se usa para validar el token del usuario.
FIREBASE_PROJECT_ID=
# AWS SES. Se usan nombres SES_* porque Vercel reserva las variables AWS_*.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Email remitente verificado en SES (identidad de email o de dominio).
SES_FROM_EMAIL=
