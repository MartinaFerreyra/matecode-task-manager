rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo lee y escribe sus propias tareas.
    match /tasks/{taskId} {
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // Límite de un email de resumen por minuto y usuario. La Lambda escribe este
    // documento con el token del usuario; las reglas rechazan (403) cualquier
    // escritura hecha antes de que pase 1 minuto. No se puede leer ni borrar.
    match /emailRateLimits/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['lastSentAt'])
                    && request.resource.data.lastSentAt == request.time;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['lastSentAt'])
                    && request.resource.data.lastSentAt == request.time
                    && request.time > resource.data.lastSentAt + duration.value(60, 's');
    }
  }
}
